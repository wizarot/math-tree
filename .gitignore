remotion-videos/public/assets/clips/
remotion-videos/public/assets/audio/
remotion-videos/public/assets/img/

# =====================
# Logs
# =====================
*.log
render*.log

# =====================
# Temp check frames
# =====================
remotion-videos/output/_chk*.png

# =====================
# OS / editor cruft
# =====================
.DS_Store
Thumbs.db
*.swp
*~
